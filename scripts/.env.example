# Configuração do scripts/backup.py
# Copie para scripts/.env e preencha. Este arquivo NÃO é versionado.

# URL base do app (sem barra no final)
ZETTEL_BACKUP_URL=http://localhost:3000

# Chave de 64 caracteres hex gerada em Configurações > Chave de backup.
# Exibida uma única vez — se perder, gere outra (a antiga é invalidada).
ZETTEL_BACKUP_KEY=

# Pasta de saída — relativa a scripts/ ou caminho absoluto
ZETTEL_BACKUP_DIR=backups

# Quantos arquivos manter antes de descartar os mais antigos
ZETTEL_BACKUP_KEEP=30
