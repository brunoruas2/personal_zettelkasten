PORT=3001
DB_PATH=zettelkasten.db
ALLOWED_ORIGIN=http://localhost:3000
# ./setup.sh gera um valor aleatório de 256 bits aqui ao criar o .env.
# Se editar à mão, use algo imprevisível: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production

# WebAuthn / Passkeys
# Em dev local: usar localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Zettelkasten
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# Em produção:
# WEBAUTHN_RP_ID=seu-dominio.com
# WEBAUTHN_RP_NAME=Zettelkasten
# WEBAUTHN_RP_ORIGIN=https://seu-dominio.com

